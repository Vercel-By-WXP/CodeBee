{
  "name": "codebee-desktop",
  "version": "0.1.109",
  "private": true,
  "description": "CodeBee desktop preview for Windows and macOS",
  "author": "CodeBee",
  "license": "MIT",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "prepare:runtime:win7": "node scripts/prepare-runtime.cjs win32 x64 win7",
    "dist:win7": "npm run prepare:runtime:win7 && electron-builder --config electron-builder.win7.yml --publish never",
    "dist:mac:arm64": "electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "electron-builder --mac dmg zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
