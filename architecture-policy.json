{
  "version": 1,
  "#": "架构策略（借鉴 zai-org/ZCode 开源的 architecture-policy 体系）。层号小→大单向依赖：L_i 只准 import L_j (j>=i)。存量违规走 .architecture-baseline.json 豁免，新增违规零容忍。scripts/architecture_check.py 是检查器。",
  "layers": {
    "0": ["paths", "settings", "settings_schema", "registry", "usage", "flows",
          "tlsctx", "remote", "error_codes", "attachments", "dispatch",
          "capability", "aiflavor", "token_meter", "compaction", "session_log",
          "repeat_guard", "diagnostics", "bookmeta_catalog", "env_scrub", "util",
          "browser", "ws", "ledger", "fanqie", "qimao", "flow", "prefs", "board"],
    "1": ["catalog", "store", "skills", "knowledge", "history", "health",
          "task_compile", "step_runner", "market", "market_remote", "skill_scan",
          "share_page", "notify", "paihang", "planner", "router",
          "builtin_agent", "modelhub", "covergen", "goal_service", "preview"],
    "2": ["runner", "manager", "jobs", "automation", "selfupdate", "cleanup",
          "backup", "errorlog", "telemetry", "gitmod", "zentao", "wxdigest",
          "publish", "publish.auto", "publish.browser", "publish.flow",
          "publish.manager", "bookmeta"],
    "3": ["pipeline", "main"]
  },
  "forbidCycles": true,
  "maxFileLines": 1200,
  "checkGlobs": ["app/**/*.py"],
  "scanRoots": ["app"]
}
